{
  "name": "devtools-desktop",
  "version": "0.1.93",
  "private": true,
  "description": "DevTools Desktop - 轻量级开发工具集",
  "scripts": {
    "dev": "npx serve src -l 1420 -s",
    "tauri": "tauri",
    "build": "node scripts/sync-version.js && tauri build -b app",
    "sync-version": "node scripts/sync-version.js",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "npx --yes eslint@9 sidecar scripts src/js",
    "lint:css": "npx --yes stylelint@16 \"src/css/*.css\""
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}