ObjC.import('Foundation');

function readJson(filePath) {
  var error = $();
  var str = $.NSString.stringWithContentsOfFileEncodingError(
    $(filePath),
    $.NSUTF8StringEncoding,
    error,
  );
  if (!str) {
    throw new Error('无法读取网关会话文件');
  }
  return JSON.parse(ObjC.unwrap(str));
}

function unlink(filePath) {
  try {
    $.NSFileManager.defaultManager.removeItemAtPathError($(filePath), null);
  } catch (e) {
    // 删不掉也不要把密码会话接着用下去；Node 侧 finally 会再删一次
  }
}

function appleEventsDisabled(error) {
  var text = String(error && error.message ? error.message : error || '');
  return /JavaScript through AppleScript is turned off|AppleScript is turned off|不允许.*JavaScript|Apple 事件/i.test(text);
}

function cannotMakeClass(error) {
  var text = String(error && error.message ? error.message : error || '');
  return /不能生成类|-2710|Can't make|Can’t make/i.test(text);
}

function describeError(error) {
  if (appleEventsDisabled(error)) {
    return 'Chrome 不允许通过 Apple 事件执行 JavaScript。请先点一下 Chrome 窗口，然后看屏幕最顶部菜单栏（不是设置页）：「显示」→「开发者」→勾选「允许 Apple 事件中的 JavaScript」，然后重试。';
  }
  if (cannotMakeClass(error)) {
    return '无法让 Chrome 打开新标签。请先手动打开 Google Chrome，确认窗口在前台后再点「重试代登」。';
  }
  return String(error && error.message ? error.message : error);
}

function ensureWindow(chrome) {
  chrome.activate();
  delay(0.6);
  if (chrome.windows.length > 0) return chrome.windows[0];
  try {
    chrome.windows.push(chrome.Window());
  } catch (error) {
    chrome.activate();
  }
  delay(0.8);
  if (chrome.windows.length === 0) {
    throw new Error('没有可用的 Chrome 窗口。请先手动打开 Google Chrome 后再试。');
  }
  return chrome.windows[0];
}

function openLoginTab(chrome, url) {
  var win = ensureWindow(chrome);
  try {
    win.tabs.push(chrome.Tab({ url: url }));
    delay(0.4);
    return win.tabs[win.tabs.length - 1];
  } catch (error) {
    // 部分 Chrome 版本不能用 Tab 构造器：退回当前标签导航，不中断代登
    win.activeTab.url = url;
    delay(0.4);
    return win.activeTab;
  }
}

function run(argv) {
  var filePath = argv[0];
  if (!filePath) {
    return JSON.stringify({ status: 'error', detail: '缺少网关会话文件' });
  }

  var payload;
  try {
    payload = readJson(filePath);
  } catch (error) {
    return JSON.stringify({ status: 'error', detail: String(error && error.message ? error.message : error) });
  }
  unlink(filePath);

  var chrome;
  try {
    chrome = Application('Google Chrome');
  } catch (error) {
    return JSON.stringify({
      status: 'error',
      detail: '未找到 Google Chrome。请安装系统版 Chrome 后再试。',
    });
  }

  try {
    var tab = openLoginTab(chrome, payload.loginUrl);
    delay(1.2);

    var tickJs = String(payload.agentScript || '');
    for (var i = 0; i < 20; i += 1) {
      var raw;
      try {
        raw = tab.execute({ javascript: tickJs });
      } catch (error) {
        return JSON.stringify({ status: 'error', detail: describeError(error) });
      }

      var text = String(raw == null ? '' : raw);
      var result;
      try {
        result = JSON.parse(text);
      } catch (error) {
        result = { status: 'error', detail: text || '页面脚本没有返回状态' };
      }
      if (result.status === 'done' || result.status === 'error') {
        return JSON.stringify(result);
      }
      var wait = 0.8;
      var detail = String(result.detail || '');
      if (detail.indexOf('已提交网关登录') !== -1) wait = 2;
      else if (detail.indexOf('等待登录页同步') !== -1) wait = 0.8;
      delay(wait);
    }

    return JSON.stringify({
      status: 'done',
      detail: '已打开网关页面。请在 Chrome 里确认登录，再点对应设备的 SFTP 调起 FileZilla。',
    });
  } catch (error) {
    return JSON.stringify({ status: 'error', detail: describeError(error) });
  }
}
