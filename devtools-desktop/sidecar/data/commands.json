[
  {
    "id": "cmd-mt-vpn-add",
    "name": "茅台 VPN 连接",
    "command": "sudo route -n add 10.34.0.0 -netmask 255.255.0.0 10.30.1.${ip}",
    "icon": "🔗",
    "hasParam": true,
    "paramName": "ip",
    "paramPlaceholder": "网关末位，默认 224",
    "paramDefault": "224"
  },
  {
    "id": "cmd-mt-vpn-del",
    "name": "茅台 VPN 清除",
    "command": "sudo route -n delete -net 10.34.0.0",
    "icon": "🔌",
    "hasParam": false
  },
  {
    "id": "cmd-bz-vpn-add",
    "name": "亳州药都 VPN 连接",
    "command": "sudo route -n add -net 192.168.10.0/24 12.12.12.1",
    "icon": "🔗",
    "hasParam": false
  },
  {
    "id": "cmd-bz-vpn-del",
    "name": "亳州药都 VPN 清除",
    "command": "sudo route -n delete -net 192.168.10.0/24 12.12.12.1",
    "icon": "🔌",
    "hasParam": false
  },
  {
    "id": "cmd-kill-port",
    "name": "杀指定端口进程",
    "command": "lsof -ti :${port} | xargs kill -9",
    "icon": "🔪",
    "hasParam": true,
    "paramName": "port",
    "paramPlaceholder": "端口号，如 8080"
  },
  {
    "id": "cmd-list-port",
    "name": "查看端口占用",
    "command": "lsof -i :${port}",
    "icon": "🔍",
    "hasParam": true,
    "paramName": "port",
    "paramPlaceholder": "端口号，如 3000"
  },
  {
    "id": "cmd-ip-address",
    "name": "查看本机 IP",
    "command": "ifconfig | grep 'inet ' | grep -v 127.0.0.1 | awk '{print $2}'",
    "icon": "🌐",
    "hasParam": false
  },
